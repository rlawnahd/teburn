# ═══════════════════════════════════════
#  TEBURN 자동매매봇 설정
# ═══════════════════════════════════════

# ── TEBURN 서버 API URL ──
# 로컬 개발: http://localhost:4000
# 프로덕션: https://your-railway-server.up.railway.app
TEBURN_API_URL=http://localhost:4000

# ── KIS Open API ──
# https://apiportal.koreainvestment.com 에서 발급
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=00000000-01
KIS_ACCOUNT_PRODUCT_CODE=01
KIS_IS_MOCK=true

# ── 매매 전략 ──
MIN_GRADE=S
MIN_HOTNESS_SCORE=70
MIN_CHANGE_RATE=4
MAX_CHANGE_RATE=25
MIN_TRADING_VALUE=10000000000

# 기술적 필터 (RSI + MA)
RSI_ENABLED=true
RSI_PERIOD=14
RSI_OVERBOUGHT=75
RSI_OVERSOLD=25
MA_ENABLED=true
MA_FAST_PERIOD=5
MA_SLOW_PERIOD=20

# ── 리스크 관리 ──
MAX_POSITIONS=3
POSITION_SIZE_KRW=500000
STOP_LOSS_PERCENT=3
TAKE_PROFIT_PERCENT=7
TRAILING_STOP_ENABLED=false
TRAILING_STOP_PERCENT=2
DAILY_LOSS_LIMIT_KRW=100000

# ── 운영 ──
CHECK_INTERVAL_MS=300000
SELL_ALL_BEFORE_CLOSE=false

# ── 텔레그램 (선택) ──
# 기존 @teburn_hot_bot과 별도 봇 생성 권장
BOT_TELEGRAM_ENABLED=false
BOT_TELEGRAM_BOT_TOKEN=
BOT_TELEGRAM_CHAT_ID=

# ── MongoDB (선택, 기존 TEBURN DB 공유 가능) ──
# MONGO_URI=mongodb://...
